if(NOT DEFINED FILO_EXECUTABLE OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "FILO_EXECUTABLE and TEST_ROOT are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(root "${TEST_ROOT}/config-overlay-${nonce}")
file(MAKE_DIRECTORY "${root}/source/filo" "${root}/personal/filo" "${root}/project")

function(run_cli expected config_home)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env "XDG_CONFIG_HOME=${config_home}"
            "XDG_STATE_HOME=${root}/state" "FILO_PROFILE=" "FILO_LOG_LEVEL=off" "FILO_LOG_FILE="
            "${FILO_EXECUTABLE}" ${ARGN}
        WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
        TIMEOUT 15)
    if(expected STREQUAL "failure" AND result MATCHES "^[1-9][0-9]*$")
        return()
    endif()
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "filo ${ARGN}: expected ${expected}, got ${result}\n${output}\n${error}")
    endif()
endfunction()

set(personal_config [[{"default_provider":"claude","ui_theme":"light"}]])
set(personal_token [[{"access_token":"fake-personal","expires_at":4102444800}]])
file(WRITE "${root}/personal/filo/config.json" "${personal_config}")
file(WRITE "${root}/personal/filo/oauth_claude.json" "${personal_token}")
file(WRITE "${root}/source/filo/auth_defaults.json"
    [[{"providers":{"claude":{"auth_type":"oauth_claude"}}}]])
file(WRITE "${root}/source/filo/oauth_claude.json"
    [[{"access_token":"fake-work","refresh_token":"fake-work-refresh","expires_at":4102444800}]])

function(check_personal)
    file(READ "${root}/personal/filo/config.json" config)
    file(READ "${root}/personal/filo/oauth_claude.json" token)
    file(GLOB files "${root}/personal/filo/*")
    list(LENGTH files count)
    if(NOT config STREQUAL personal_config OR NOT token STREQUAL personal_token OR NOT count EQUAL 2)
        message(FATAL_ERROR "--config changed the personal configuration")
    endif()
endfunction()

run_cli(0 "${root}/source" --export work.json --only claude --include-secrets)
file(READ "${root}/work.json" bundle)
run_cli(0 "${root}/personal" --config work.json -w project --auth logout claude)
file(GLOB states "${root}/state/filo/configs/*")
list(LENGTH states count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one isolated state directory")
endif()
list(GET states 0 state)
if(EXISTS "${state}/oauth_claude.json" OR NOT EXISTS "${state}/oauth_claude.json.selected")
    message(FATAL_ERROR "Bundle logout did not stay in Filo state")
endif()
if(EXISTS "${root}/work.json.d" OR EXISTS "${state}/auth_defaults.json")
    message(FATAL_ERROR "The bundle configuration was materialized instead of read directly")
endif()
check_personal()
run_cli(0 "${root}/personal" --config work.json --auth logout claude)
if(EXISTS "${state}/oauth_claude.json")
    message(FATAL_ERROR "Reopening the bundle restored a signed-out login")
endif()
file(READ "${root}/work.json" after)
if(NOT after STREQUAL bundle)
    message(FATAL_ERROR "The original bundle was modified")
endif()

# Replacing source credentials keeps the directory and saved settings. An
# unchanged source must subsequently leave refreshed tokens and logout alone.
set(saved_settings [[{"ui_theme":"dark","ui_footer":"hide"}]])
file(WRITE "${state}/settings.json" "${saved_settings}")
string(REPLACE "fake-work" "replacement-work" bundle "${bundle}")
file(WRITE "${root}/work.json" "${bundle}")
run_cli(0 "${root}/personal" --config work.json --auth logout openai)
file(GLOB states "${root}/state/filo/configs/*")
list(LENGTH states count)
file(READ "${state}/settings.json" settings)
file(READ "${state}/oauth_claude.json" replacement_token)
if(NOT count EQUAL 1 OR NOT settings STREQUAL saved_settings OR NOT replacement_token MATCHES "replacement-work")
    message(FATAL_ERROR "Replacing source credentials reset settings or failed to select the replacement")
endif()
run_cli(0 "${root}/personal" --config work.json --auth logout claude)
check_personal()

file(MAKE_DIRECTORY "${root}/config back")
file(WRITE "${root}/config back/oauth_claude.json" "${personal_token}")
run_cli(0 "${root}/personal" --config "config back" --auth logout claude)
file(READ "${root}/config back/oauth_claude.json" original)
file(GLOB input_files "${root}/config back/*")
list(LENGTH input_files input_count)
if(NOT original STREQUAL personal_token OR NOT input_count EQUAL 1)
    message(FATAL_ERROR "The supplied directory was changed")
endif()
check_personal()
run_cli(0 "${root}/unused-default" --config "config back" --auth logout claude)
if(EXISTS "${root}/unused-default")
    message(FATAL_ERROR "Overlay mode created the default configuration")
endif()

# A read-only source location must not need any adjacent writable storage.
file(MAKE_DIRECTORY "${root}/read only")
file(WRITE "${root}/read only/work.json" "${bundle}")
file(CHMOD "${root}/read only/work.json" PERMISSIONS OWNER_READ)
file(CHMOD "${root}/read only" PERMISSIONS OWNER_READ OWNER_EXECUTE)
run_cli(0 "${root}/personal" --config "read only/work.json" --auth logout claude)
file(GLOB adjacent "${root}/read only/*")
list(LENGTH adjacent adjacent_count)
if(NOT adjacent_count EQUAL 1)
    message(FATAL_ERROR "Files were created alongside a read-only export")
endif()
file(CHMOD "${root}/read only" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)

file(GLOB before_invalid "${root}/state/filo/configs/*")
run_cli(2 "${root}/personal" --config missing --auth logout claude)
file(MAKE_DIRECTORY "${root}/invalid")
file(WRITE "${root}/invalid/config.json" [[{"providers":{"claude":{"auth_type":false}}}]])
run_cli(2 "${root}/personal" --config invalid --auth logout claude)
file(WRITE "${root}/bad.json" [[{"format":"filo-config-bundle","version":999,"items":[]}]])
run_cli(2 "${root}/personal" --config bad.json --auth logout claude)
file(WRITE "${root}/bad.json" "{}")
run_cli(2 "${root}/personal" --config bad.json --auth logout claude)
file(GLOB after_invalid "${root}/state/filo/configs/*")
if(NOT before_invalid STREQUAL after_invalid)
    message(FATAL_ERROR "Invalid input created runtime state")
endif()

# These options fail at CLI validation before creating any config state.
file(WRITE "${root}/unused.json" "${bundle}")
run_cli(2 "${root}/personal" --config unused.json --only claude)
run_cli(failure "${root}/personal" --config unused.json --export never-written.json)
run_cli(failure "${root}/personal" --config unused.json --import work.json)
if(EXISTS "${root}/never-written.json" OR EXISTS "${root}/unused.json.d")
    message(FATAL_ERROR "Conflicting options were accepted or wrote state")
endif()

# Editing configuration does not pin the input to an old copied document.
file(APPEND "${root}/work.json" "\n")
run_cli(0 "${root}/personal" --config work.json --auth logout claude)
if(EXISTS "${state}/oauth_claude.json" OR EXISTS "${root}/work.json.d")
    message(FATAL_ERROR "A config edit reset the signed-out account or created an adjacent directory")
endif()
check_personal()

# Omitting --config retains the normal configuration location and never
# creates a per-config state namespace or an overlay logout marker.
file(GLOB states_before_native "${root}/state/filo/configs/*")
run_cli(0 "${root}/native" --auth logout kimi)
if(NOT EXISTS "${root}/native/filo/config.json" OR
   EXISTS "${root}/native/filo/oauth_kimi.json.selected")
    message(FATAL_ERROR "Normal startup changed its default configuration persistence")
endif()
file(READ "${root}/native/filo/config.json" native_config)
run_cli(0 "${root}/native" --auth logout kimi)
file(READ "${root}/native/filo/config.json" native_reopened)
file(GLOB states_after_native "${root}/state/filo/configs/*")
if(NOT native_config STREQUAL native_reopened OR NOT states_before_native STREQUAL states_after_native)
    message(FATAL_ERROR "Normal startup rewrote defaults or created isolated config state")
endif()
file(REMOVE_RECURSE "${root}")
